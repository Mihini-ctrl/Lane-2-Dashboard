# Browser-safe Supabase settings. The publishable key is safe to expose only
# when every exposed table has correct grants and Row Level Security policies.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# Optional for the current user-scoped API. It will be required for future
# Canvas roster sync and other privileged jobs. Never expose it to the browser.
# SUPABASE_SECRET_KEY=sb_secret_replace_me

# The production API defaults to 3100 so it can run beside the prototype.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=3100

# Read by server.js. When set, the browser uses the authenticated API instead
# of the JSON demo store.
BACKEND_URL=http://127.0.0.1:3100
