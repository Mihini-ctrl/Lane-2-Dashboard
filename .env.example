# Browser-safe Supabase settings. The publishable key is safe to expose only
# when every exposed table has correct grants and Row Level Security policies.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-only. Never put this value in public/ or client-side JavaScript.
SUPABASE_SECRET_KEY=sb_secret_replace_me

# The production API defaults to 3100 so it can run beside the prototype.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=3100
